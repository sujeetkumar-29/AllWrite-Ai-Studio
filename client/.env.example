# Clerk publishable key (Dashboard -> API Keys -> Publishable key)
# Must be the SAME Clerk application/instance as your backend's CLERK_SECRET_KEY,
# otherwise session tokens issued here won't be accepted by the API.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of your existing Express backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000
